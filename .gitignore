/config.json
*.log

# Debug captures (must never be committed)
/debug_captures/
scripts/out/
_dbg_*.png
_dbg_*.jpg

# Local Cursor overrides (optional; keep repo clean)
.cursor/permissions.json
.cursor/sandbox.json
