# Joy 本地配置示例（复制为项目根目录 config.json；不要把真实 Key 写进本文件）
# API Key 请走环境变量，例如：
#   JOY_VISION_API_KEY / JOY_LLM_API_KEY / JOY_DRAFT_API_KEY
# 或在设置页填写（写入本机凭据/环境变量，不进此文件）

{
  "capture": {
    "paused": false,
    "target": "wechat_win",
    "poll_interval_ms": 800,
    "max_image_side": 960,
    "jpeg_quality": 72,
    "crop": {
      "left": 0.22,
      "top": 0.08,
      "right": 0.02,
      "bottom": 0.12
    }
  },
  "chat": {
    "relation": "朋友",
    "style": "简洁口语",
    "context_messages": 10
  },
  "providers": {
    "vision": {
      "preset": "sensenova",
      "base_url": "",
      "model": "",
      "api_key_env": "JOY_VISION_API_KEY"
    },
    "analyze": {
      "preset": "deepseek",
      "base_url": "",
      "model": "",
      "api_key_env": "JOY_LLM_API_KEY"
    },
    "draft": {
      "preset": "deepseek",
      "base_url": "",
      "model": "",
      "api_key_env": "JOY_DRAFT_API_KEY"
    }
  },
  "ui": {
    "check_update_on_start": false,
    "confirm_vision_upload": true
  }
}
